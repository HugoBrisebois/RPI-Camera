QMainWindow, QWidget {
	background-color: #171a1d;
	color: #edf0f2;
	font-family: "DejaVu Sans";
	font-size: 15px;
}

QLabel#sectionTitle {
	color: #a8d8ca;
	font-size: 16px;
	font-weight: 700;
}

QLabel#status {
	color: #b7c0c5;
	padding: 4px;
	font-size: 13px;
}

QLabel#preview {
	background-color: #080a0b;
	color: #98a3a9;
	font-size: 20px;
}

QScrollArea#settingsScroll {
	background-color: #171a1d;
	border: 0;
}

QSpinBox, QDoubleSpinBox, QComboBox {
	background-color: #252a2e;
	border: 1px solid #515b61;
	border-radius: 4px;
	min-height: 48px;
	padding: 2px 8px;
	font-size: 15px;
}

QCheckBox {
	min-height: 48px;
	spacing: 10px;
	font-size: 15px;
}

QCheckBox::indicator {
	width: 28px;
	height: 28px;
}

QPushButton {
	background-color: #35413f;
	border: 1px solid #65736f;
	border-radius: 5px;
	min-height: 50px;
	padding: 4px 8px;
	font-size: 15px;
}

QPushButton:hover {
	background-color: #465650;
}

QPushButton:pressed {
	background-color: #29332f;
}

QPushButton:disabled {
	background-color: #252a2e;
	color: #778087;
}

QPushButton#shutterButton {
	background-color: #d8583e;
	border: 3px solid #f3b09f;
	border-radius: 34px;
	min-width: 68px;
	max-width: 68px;
	min-height: 68px;
	max-height: 68px;
	font-size: 25px;
}

QPushButton#shutterButton:hover {
	background-color: #ed7359;
}

QPushButton#folderButton, QPushButton#transferButton {
	min-width: 76px;
	min-height: 52px;
}

QPushButton#photosButton {
	min-width: 72px;
	min-height: 52px;
}

QPushButton#fullscreenButton {
	min-width: 92px;
	min-height: 52px;
}

QWidget[objectName$="Row"] QLabel {
	font-size: 14px;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
	width: 30px;
}

QComboBox::drop-down {
	width: 38px;
}

QSlider {
	min-height: 48px;
	padding: 2px 8px;
}

QSlider::groove:horizontal {
	height: 10px;
	background-color: #394247;
	border-radius: 5px;
	margin: 0 14px;
}

QSlider::sub-page:horizontal {
	background-color: #a8d8ca;
	border-radius: 5px;
}

QSlider::handle:horizontal {
	width: 32px;
	height: 32px;
	margin: -12px 0;
	background-color: #edf0f2;
	border: 2px solid #a8d8ca;
	border-radius: 18px;
}

QScrollBar:vertical {
	width: 22px;
	background: #202528;
}

QScrollBar::handle:vertical {
	min-height: 52px;
	background: #65736f;
	border-radius: 6px;
}

QDialog#transferDialog {
	min-width: 420px;
}

QDialog#transferDialog QLabel {
	min-height: 34px;
}

QComboBox#driveChoice, QComboBox#transferAction {
	min-height: 48px;
}

QDialog#transferDialog QPushButton {
	min-height: 48px;
}

QDialog#photoGallery {
	background-color: #101416;
}

QLabel#galleryTitle {
	font-size: 22px;
	font-weight: 700;
}

QLabel#galleryCount {
	color: #b7c0c5;
}

QLabel#galleryPhoto {
	background-color: #080a0b;
	color: #f3b09f;
	font-size: 18px;
}

QLabel#galleryEmptyState {
	color: #b7c0c5;
	font-size: 20px;
}

QListWidget#photoThumbnails {
	background-color: #171a1d;
	border: 1px solid #394247;
	outline: 0;
}

QListWidget#photoThumbnails::item {
	min-width: 116px;
	min-height: 92px;
	padding: 4px;
}

QListWidget#photoThumbnails::item:selected {
	background-color: #35413f;
	border: 1px solid #a8d8ca;
}

QPushButton#galleryBackButton {
	min-width: 100px;
	min-height: 52px;
}
